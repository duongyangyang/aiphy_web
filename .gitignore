# Lỗi cục bộ
node_modules
dist
dist-ssr
*.local

# Hệ điều hành
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Log
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Môi trường
.env
.env.local
.env.*.local
!.env.production.example

# Dữ liệu runtime — KHÔNG commit database người dùng thật
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
server/data/backups/
# Chỉ thư mục data/ ở GỐC repo (volume Docker). Thiếu dấu "/" đầu thì mẫu này
# khớp cả src/data/ và làm git bỏ qua mọi file mới trong đó.
/data/

# Python ML
ml_venv/
__pycache__/
*.pyc

# Model checkpoints — KHÔNG commit lên git (quá nặng cho GitHub).
# Chép thủ công vào module3_deploy/ và module4_deploy/ trước khi chạy ML;
# xem mục "Model checkpoints" trong README.md.
module3_deploy/*.pt
module4_deploy/*.pth

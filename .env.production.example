# ══════════════════════════════════════════════════════════════════════
# Cấu hình triển khai VPS — copy file này thành `.env` rồi sửa 2 dòng.
#   cp .env.production.example .env
# ══════════════════════════════════════════════════════════════════════

# Tên miền đã trỏ về IP của VPS (không kèm https://, không có dấu / ở cuối).
# Caddy dùng biến này để xin chứng chỉ TLS.
DOMAIN=your-domain.com

# Địa chỉ gốc của website — dùng cho kiểm tra Origin (chống CSRF).
# Phải khớp chính xác với tên miền ở trên, có https://.
APP_ORIGIN=https://your-domain.com

# ══════════════════════════════════════════════════════════════════════
# Cấu hình triển khai VPS — copy file này thành `.env` rồi sửa 2 dòng.
#   cp .env.production.example .env
# ══════════════════════════════════════════════════════════════════════

# Tên miền đã trỏ về IP của VPS (không kèm https://, không có dấu / ở cuối).
# Caddy dùng biến này để xin chứng chỉ TLS.
DOMAIN=your-domain.com

# Địa chỉ gốc của website — dùng cho kiểm tra Origin (chống CSRF).
# Phải khớp chính xác với tên miền ở trên, có https://.
APP_ORIGIN=https://your-domain.com

# Bật mô hình học sâu (Module 3 & 4).
#   false (mặc định) — Module 3/4 vẫn hiển thị đầy đủ nội dung, nhưng bấm chạy
#                      sẽ báo "chưa hỗ trợ do giới hạn phần cứng". Không cần
#                      build/ chạy container ML.
#   true             — cần VPS ≥ 4 GB RAM và phải chạy thêm:
#                      docker compose --profile ml up -d --build
ML_ENABLED=false

# ═══════════════════════════════════════════════════════════════
# Yêu cầu phần mềm (cài trên máy lab Windows)
# ═══════════════════════════════════════════════════════════════
#
# 1. Node.js 18+ LTS          https://nodejs.org
# 2. TigerVNC Server (Win)    https://tigervnc.org
#    - Chạy VNC Server, đặt mật khẩu, nghe cổng 5900 (display :0)
#    - Phục vụ desktop Windows hiện tại (chứa app MRI)
# 3. ngrok (trả phí, reserved domain)
#    https://ngrok.com/download
#    - `ngrok config add-authtoken <TOKEN>`
#    - Đã có reserved domain: <ten>.ngrok.app
#
# ═══════════════════════════════════════════════════════════════
# Cấu hình server (copy sang .env rồi sửa)
# ═══════════════════════════════════════════════════════════════

# Cổng server Node (ngrok sẽ nạm cổng này)
PORT=3000

# Địa chỉ TigerVNC (mặc định 127.0.0.1:5900 = display :0)
VNC_HOST=127.0.0.1
VNC_PORT=5900

# Mật khẩu VNC (đặt = mật khẩu đã cấu hình trong TigerVNC).
# Để trống nếu muốn trình duyệt tự prompt người dùng nhập.
VNC_PASSWORD=

# Bật/tắt tính năng "Thí nghiệm thực tế online" (true/false)
REMOTE_LAB_ENABLED=true

# Caddy phục web qua biến SITE_ADDRESS.
#
#   SITE_ADDRESS trống  → ":80"  → chạy thẳng bằng http://<IP> (chưa có tên miền)
#   SITE_ADDRESS=domain.com → Caddy tự xin và gia hạn chứng chỉ Let's Encrypt
#
# Đổi cách chạy chỉ bằng cách sửa biến trong .env, không cần sửa file này.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Giới hạn kích thước request ở tầng proxy (phòng thủ chiều sâu).
	request_body {
		max_size 12MB
	}

	reverse_proxy app:8787 {
		# Chuyển IP thật cho Express để rate-limit theo IP hoạt động đúng.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		# HSTS chỉ có ý nghĩa khi đã bật HTTPS; vô hại khi chạy HTTP.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format console
	}
}

{
  "name": "aiphys-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nền tảng số giúp học sinh/sinh viên tiếp cận thí nghiệm MRI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently -n web,api,ml -c cyan,magenta,green \"npm:dev\" \"npm:server\" \"npm:ml\"",
    "ml": "python ml_service/server.py",
    "admin:create": "tsx scripts/create-admin.ts",
    "sim:phantom": "tsx src/mri-sim/run-phantom.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "chart.js": "^4.4.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "katex": "^0.16.11",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-katex": "^3.0.1",
    "react-router-dom": "^6.26.2",
    "tsx": "^4.19.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-katex": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  }
}
